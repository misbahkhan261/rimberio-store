# Rimberio Platform — Backend Environment Variables
# Copy this file to .env and adjust values as needed.

FLASK_ENV=development
HOST=0.0.0.0
PORT=5000
DEBUG=true

# Base URL used for constructing product image URLs
BASE_URL=http://127.0.0.1:5000

# Path to public assets directory (default: auto-detected relative to app.py)
# PUBLIC_DIR=

# CORS allowed origins (comma-separated, or * for all)
CORS_ORIGINS=*

# Flat delivery charge in Rs
FLAT_DELIVERY_CHARGE=399

# Logging level
LOG_LEVEL=INFO
